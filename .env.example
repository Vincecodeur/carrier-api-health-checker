# ============================================================================
# Carrier API Health Checker — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ============================================================================

# Teams webhook URL for notifications (optional)
# Get it from: Teams > Channel > Workflows > "Send webhook alerts to a channel"
WEBHOOK_URL=

# Default export format: csv, json, or html (optional, default: json)
# EXPORT_FORMAT=json

# Default watch interval in minutes (optional, no default = single run)
# WATCH_INTERVAL=5
